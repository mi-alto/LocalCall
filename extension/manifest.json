{
  "manifest_version": 3,
  "name": "LocalCall \u00b7 Trascrizioni private",
  "version": "0.3.7",
  "minimum_chrome_version": "120",
  "description": "Registra Meet e Teams e trascrive esclusivamente sul tuo Mac.",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage",
    "scripting",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://teams.cloud.microsoft/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:8765"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*"
      ],
      "js": [
        "invite.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
